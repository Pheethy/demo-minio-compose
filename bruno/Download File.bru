meta {
  name: Download File
  type: http
  seq: 2
}

get {
  url: http://localhost:8080/file?key=assets/Screenshot_20260909_115711_Instagram.jpg
  body: none
  auth: none
}

params:query {
  key: assets/Screenshot_20260909_115711_Instagram.jpg
}

tests {
  test("returns a successful download response", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("content-disposition")).to.include("attachment");
  });
}

docs {
  Downloads a file by query key from the configured MinIO bucket.
  Start the API locally, select the local environment, then send this request.
}
